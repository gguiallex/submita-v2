// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Edicao {
  id      Int       @id @default(autoincrement())
  nome    String
  ano     Int
  eventos Evento[]
}

model Evento {
  id      Int       @id @default(autoincrement())
  titulo  String
  sigla   String

  // Relacionamento com Edicao
  edicaoId  Int
  edicao    Edicao  @relation(fields: [edicaoId], references: [id])

  // Relacionamento com o Administrador do Evento
  adminId    Int
  admin      Usuario  @relation(fields: [adminId], references: [id])
}

model Usuario {
  id      Int     @id @default(autoincrement())
  nome    String
  email   String  @unique
  role    String  @default("AUTOR") //ADMIN_GERAL, ADMIN_EVENTO, REVISOR, AUTOR
  eventos Evento[] // Eventos que este usuário administra
}

model Tema {
  id    Int    @id @default(autoincrement())
  nome  String @unique
}